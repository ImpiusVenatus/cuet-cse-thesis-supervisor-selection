# Copy to ".env" in this directory (backend/) and adjust.
# Loaded automatically by pydantic-settings when you run FastAPI from backend/.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# If set: use this URL with SQLAlchemy (Postgres, e.g. Neon).
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# If omitted: SQLite at backend/data/thesis.db (same file Alembic uses when DATABASE_URL is unset).
#
# DATABASE_URL=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Reserved for future use (e.g. stricter prod checks). Startup always runs Alembic `upgrade head`
# against the resolved URL above (Neon or SQLite)—no manual migration step required for local dev.
# ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Optional: CORS extra origins when using NEXT_PUBLIC_API_URL (browser hits API directly).
# -----------------------------------------------------------------------------
# Example: NEXT.js on another host/port.
# CORS_ORIGINS_EXTRA=http://192.168.1.10:3000,https://app.example.com
